# ---------------------------------------------------------------------------
# Applied Epic automation - LOCAL credentials/config
#
# HOW TO USE:
#   1. Copy this file to a new file named exactly ".env" in the same folder.
#   2. Fill in your real values below.
#   3. NEVER commit the .env file. It is already listed in .gitignore.
#
# The .env file stays only on your local desktop. Do not share it.
# ---------------------------------------------------------------------------

# Your Applied Epic login URL (the base portal URL).
EPIC_URL=https://liber23.appliedepic.com/#/

# Your Applied Epic credentials.
EPIC_USERNAME=your.username@example.com
EPIC_PASSWORD=your-password-here

# Where the authenticated browser session is saved after you log in once.
# This file lets later runs skip the login + push-notification prompt.
# Keep it local; it is git-ignored. Delete it to force a fresh login.
EPIC_STORAGE_STATE=storage_state.json

# Folder where downloaded documents will be saved.
# Example matches the Key Risk automation project layout.
DOWNLOAD_DIR=C:\Users\Samarth\Documents\Key Risk automation\downloads

# How long (in seconds) to wait for you to finish logging in and approving
# the push notification during the one-time login step.
LOGIN_TIMEOUT_SECONDS=300

# Set to true to watch the browser during document fetching (useful for
# debugging / first runs). Set to false to run headless once it works.
HEADLESS=false
